tion": "Component 7", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null}, {"id": "blueprint_puzzle_catalog_model", "label": "PuzzleCatalog Data Model", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Data Models: PuzzleCatalog", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null}, {"id": "blueprint_puzzle_model", "label": "Puzzle Data Model", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Data Models: Puzzle", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null}, {"id": "blueprint_attempt_model", "label": "Attempt Data Model", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Data Models: Attempt", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null}, {"id": "blueprint_exact_set_scoring", "label": "Exact Hanging-Set Scoring", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Relationships and Invariants", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null}, {"id": "blueprint_pin_agnostic_attack_maps", "label": "python-chess Pin-Agnostic Attack Maps", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Decision 3", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null, "rationale": "python-chess directly supports FEN, UCI moves, board validation, and geometric attacker semantics that count pinned pieces, avoiding the correctness risk of custom rules and duplicated browser rules."}, {"id": "blueprint_immutable_catalog_precomputed_answers", "label": "Immutable Catalog with Precomputed Answers", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Decision 4", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null, "rationale": "A versioned build-time catalog makes the 100-position set reproducible, removes runtime Lichess dependency, keeps submission deterministic, and preserves provenance and rule-version reviewability."}, {"id": "blueprint_sqlite_progress_authority", "label": "SQLite as Progress Authority", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Decision 5", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null, "rationale": "SQLite transactions and uniqueness constraints prevent phantom or duplicate attempts while keeping data local and avoiding a separate service or custom file-locking scheme."}, {"id": "blueprint_custom_accessible_selection_board", "label": "Custom Accessible Selection Board", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Decision 2", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null, "rationale": "The product selects pieces but never moves them, so an 8x8 semantic button grid gives direct control over overlapping marker and eligibility states with native keyboard and focus semantics."}, {"id": "blueprint_loopback_same_origin_runtime", "label": "Loopback-Only Same-Origin Runtime", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Decision 6", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null, "rationale": "The application is personal and local, so binding to 127.0.0.1, serving local assets, disabling CORS, and validating mutation origins prevents arbitrary cross-origin writes without introducing authentication scope."}, {"id": "blueprint_flask_server_rendered_shell", "label": "Flask and Server-Rendered Shell", "file_type": "document", "source_file": "design/blueprint.md", "source_location": "Decision 1", "source_url": null, "captured_at": null, "author": "Michael Farrugia", "contributor": null, "rationale": "One focuse